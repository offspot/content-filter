#: src/contentfilter/main.py:203 src/contentfilter/main.py:235
msgid "Incorrect username or password"
msgstr "Nom d’utilisateur ou mot de passe incorrect."

#: src/contentfilter/main.py:257 src/contentfilter/main.py:277
msgid "Supplied URL is not a valid URL"
msgstr "L’URL fournie n’est pas valide."

#: src/contentfilter/main.py:259
msgid "This URL is already in the list"
msgstr "Cette URL figure déjà dans la liste."

#: src/contentfilter/main.py:263
msgid "URL successfuly added to the list"
msgstr "L’URL a bien été ajoutée à la liste."

#: src/contentfilter/main.py:281
msgid "Updated URL already in list. Remove this one instead"
msgstr "La nouvelle URL figure déjà dans la liste. Supprimez plutôt celle-ci."

#: src/contentfilter/main.py:285
msgid "This URL is not in the list. Add it instead"
msgstr "Cette URL ne figure pas dans la liste. Ajoutez-la plutôt."

#: src/contentfilter/main.py:310
#, python-format
msgid "Successfully removed %(num_urls)s blocked URL(s) from the list"
msgstr "%(num_urls)s URLs bloquées ont été supprimées de la liste avec succès."

#: src/contentfilter/main.py:315
msgid "The list was already empty"
msgstr "La liste était déjà vide."

#: src/contentfilter/main.py:317
#, python-format
msgid "Unable to remove URLs: %(exc)s."
msgstr "Impossible de supprimer les URL : %(exc)s."

#: src/contentfilter/main.py:331
msgid "URL successfuly removed from the list"
msgstr "L’URL a été supprimée de la liste avec succès."

#: src/contentfilter/main.py:333
msgid "This URL wasn't in the list"
msgstr "Cette URL ne figurait pas dans la liste."

#: src/contentfilter/main.py:364
#, python-format
msgid "Unable to import this file: %(exc)s."
msgstr "Impossible d’importer ce fichier : %(exc)s."

#: src/contentfilter/main.py:376
#, python-format
msgid "Successfuly imported %(num_urls)s URLs into the list"
msgstr "%(num_urls)s URL importées avec succès dans la liste."

#: src/contentfilter/main.py:384
msgid "No URL imported from that file. Was it empty? Duplicates?"
msgstr "Aucune URL n’a été importée depuis ce fichier. Fichier vide ? Doublons ?"

